{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "overall_explanation"],
  "properties": {
    "findings": {
      "type": "array",
      "description": "Findings de la review, classés P0 (bloquant) à P3 (mineur)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "title", "body", "file", "line_start", "line_end"],
        "properties": {
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "title": { "type": "string", "description": "Titre court du finding" },
          "body": { "type": "string", "description": "Explication complète : défaut, scénario d'échec, correctif suggéré" },
          "file": { "type": "string", "description": "Chemin du fichier RELATIF à la racine du dépôt" },
          "line_start": { "type": "integer" },
          "line_end": { "type": "integer" }
        }
      }
    },
    "overall_explanation": {
      "type": "string",
      "description": "Synthèse de la review en quelques phrases"
    }
  }
}
