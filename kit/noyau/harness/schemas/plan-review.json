{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "critique_bloquant", "resume", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["solide", "a_reviser", "a_rejeter"],
      "description": "Jugement global du plan technique"
    },
    "critique_bloquant": {
      "type": "boolean",
      "description": "true si au moins un finding critique impose de remonter à la personne qui approuve avant de coder"
    },
    "resume": {
      "type": "string",
      "description": "Synthèse en 3 phrases maximum"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severite", "titre", "detail", "recommandation"],
        "properties": {
          "severite": { "type": "string", "enum": ["critique", "majeur", "mineur"] },
          "titre": { "type": "string" },
          "detail": { "type": "string", "description": "Le problème technique, vérifié contre le code réel" },
          "recommandation": { "type": "string" }
        }
      }
    }
  }
}
